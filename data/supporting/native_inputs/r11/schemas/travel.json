          "type": "array"
        }
      },
      "required": [
        "hotel_list"
      ],
      "title": "Hotels",
      "type": "object"
    },
    "Inbox": {
      "properties": {
        "account_email": {
          "format": "email",
          "title": "Account Email",
          "type": "string"
        },
        "initial_emails": {
          "items": {
            "$ref": "#/$defs/Email"
          },
          "title": "Initial Emails",
          "type": "array"
        },
        "emails": {
          "additionalProperties": {
            "$ref": "#/$defs/Email"
          },
          "default": {},
          "title": "Emails",
          "type": "object"
        },
        "contact_list": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EmailContact"
          },
          "title": "Contact List",
          "type": "array"
        },
        "trash": {
          "additionalProperties": {
            "$ref": "#/$defs/Email"
          },
          "default": {},
          "title": "Trash",
          "type": "object"
        },
        "received": {
          "items": {
            "$ref": "#/$defs/Email"
          },
          "readOnly": true,
          "title": "Received",
          "type": "array"
        },
        "sent": {
          "items": {
            "$ref": "#/$defs/Email"
          },
          "readOnly": true,
          "title": "Sent",
          "type": "array"
        },
        "drafts": {
          "items": {
            "$ref": "#/$defs/Email"
          },
          "readOnly": true,
          "title": "Drafts",
          "type": "array"
        }
      },
      "required": [
        "account_email",
        "initial_emails",
        "received",
        "sent",
        "drafts"
      ],
      "title": "Inbox",
      "type": "object"
    },
