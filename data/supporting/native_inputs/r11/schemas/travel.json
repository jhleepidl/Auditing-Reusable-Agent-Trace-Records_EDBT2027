        },
        "arrival_city": {
          "title": "Arrival City",
          "type": "string"
        },
        "departure_time": {
          "format": "date-time",
          "title": "Departure Time",
          "type": "string"
        },
        "arrival_time": {
          "format": "date-time",
          "title": "Arrival Time",
          "type": "string"
        },
        "price": {
          "title": "Price",
          "type": "number"
        },
        "contact_information": {
          "title": "Contact Information",
          "type": "string"
        }
      },
      "required": [
        "airline",
        "flight_number",
        "departure_city",
        "arrival_city",
        "departure_time",
        "arrival_time",
        "price",
        "contact_information"
