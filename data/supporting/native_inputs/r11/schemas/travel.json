{
  "$defs": {
    "Calendar": {
      "properties": {
        "current_day": {
          "format": "date",
          "title": "Current Day",
          "type": "string"
        },
        "account_email": {
          "format": "email",
          "title": "Account Email",
          "type": "string"
        },
        "initial_events": {
          "items": {
            "$ref": "#/$defs/CalendarEvent"
          },
          "title": "Initial Events",
          "type": "array"
        },
        "events": {
          "additionalProperties": {
            "$ref": "#/$defs/CalendarEvent"
          },
          "default": {},
          "title": "Events",
          "type": "object"
        }
      },
      "required": [
        "current_day",
        "account_email",
        "initial_events"
      ],
      "title": "Calendar",
      "type": "object"
    },
    "CalendarEvent": {
      "properties": {
        "id_": {
          "description": "The unique identifier of the event",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "The title of the event",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "The description of the event",
          "title": "Description",
          "type": "string"
        },
        "start_time": {
          "description": "The start time of the event",
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        },
        "end_time": {
          "description": "The end time of the event",
          "format": "date-time",
          "title": "End Time",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The location of the event",
          "title": "Location"
        },
        "participants": {
          "description": "The list of the emails of the participants",
          "items": {
            "format": "email",
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "all_day": {
          "default": false,
          "description": "Whether the event is all day",
          "title": "All Day",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/EvenStatus",
          "default": "confirmed",
          "description": "The status of the event"
        }
      },
      "required": [
        "id_",
        "title",
        "description",
        "start_time",
        "end_time",
        "location",
        "participants"
      ],
      "title": "CalendarEvent",
      "type": "object"
    },
    "CarRental": {
      "properties": {
        "company_list": {
          "items": {
            "$ref": "#/$defs/CarRentalCompany"
          },
          "title": "Company List",
          "type": "array"
        }
      },
      "required": [
        "company_list"
      ],
      "title": "CarRental",
      "type": "object"
    },
    "CarRentalCompany": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "city": {
          "title": "City",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "rating": {
          "title": "Rating",
          "type": "number"
        },
        "price_per_day": {
          "title": "Price Per Day",
          "type": "number"
        },
        "reviews": {
          "items": {},
          "title": "Reviews",
          "type": "array"
        },
        "contact_information": {
          "title": "Contact Information",
          "type": "string"
        },
        "car_types_available": {
          "items": {},
          "title": "Car Types Available",
          "type": "array"
        },
        "fuel_options": {
          "items": {},
          "title": "Fuel Options",
          "type": "array"
        }
      },
      "required": [
        "name",
        "city",
        "address",
        "rating",
        "price_per_day",
        "reviews",
        "contact_information",
        "car_types_available",
        "fuel_options"
      ],
      "title": "CarRentalCompany",
      "type": "object"
    },
    "Email": {
      "properties": {
        "id_": {
          "description": "The unique identifier of the email",
          "title": "Id",
          "type": "string"
        },
        "sender": {
          "description": "The email of the sender",
          "format": "email",
          "title": "Sender",
          "type": "string"
        },
        "recipients": {
          "description": "The list of the emails of the recipients",
          "items": {
            "format": "email",
            "type": "string"
          },
          "title": "Recipients",
          "type": "array"
        },
        "cc": {
          "description": "The list of the emails of the CC recipients",
          "items": {
            "format": "email",
            "type": "string"
          },
          "title": "Cc",
          "type": "array"
        },
        "bcc": {
          "description": "The list of the emails of the BCC recipients",
          "items": {
            "format": "email",
            "type": "string"
          },
          "title": "Bcc",
          "type": "array"
        },
        "subject": {
          "description": "The subject of the email",
          "title": "Subject",
          "type": "string"
        },
        "body": {
          "description": "The body of the email",
          "title": "Body",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EmailStatus",
          "default": "sent",
          "description": "The status of the email"
        },
        "read": {
          "default": false,
          "description": "Whether the email has been read",
          "title": "Read",
          "type": "boolean"
        },
        "timestamp": {
          "description": "The timestamp of the email",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "attachments": {
          "description": "The list of attachments of the email. If the attachment is a file, it will be the ID of the file. If the attachment is a calendar event, it will be a CalendarEvent object.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/CalendarEvent"
              }
            ]
          },
          "title": "Attachments",
          "type": "array"
        }
      },
      "required": [
        "id_",
        "sender",
        "recipients",
        "subject",
        "body"
      ],
      "title": "Email",
      "type": "object"
    },
    "EmailContact": {
      "properties": {
        "email": {
          "format": "email",
          "title": "Email",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "email",
        "name"
      ],
      "title": "EmailContact",
      "type": "object"
    },
    "EmailStatus": {
      "enum": [
        "sent",
        "received",
        "draft"
      ],
      "title": "EmailStatus",
      "type": "string"
    },
    "EvenStatus": {
      "enum": [
        "confirmed",
        "canceled"
      ],
      "title": "EvenStatus",
      "type": "string"
    },
